# =====================================================================
#  RupeeRise backend - environment variables  (TEMPLATE, safe to commit)
#  Copy this file to ".env" and fill in the real values.
#  NEVER commit ".env". On Render, add these in Dashboard > Environment.
# =====================================================================

# ---- Server ----
PORT=5000
NODE_ENV=production
APP_TIMEZONE=Asia/Kolkata

# ---- Firebase Admin (REQUIRED) ----
# Base64 of your service-account JSON. Create it with:
#   node -e "console.log(require('fs').readFileSync('backend/firebaseServiceAccountKey.json').toString('base64'))"
# Paste the printed line below, then you can delete backend/firebaseServiceAccountKey.json.
FIREBASE_SERVICE_ACCOUNT=

# ---- Digital signatures for statements / receipts ----
# Create the key + certificate with:  npm run gen:cert   (it prints both values)
SIGN_ALGO=sha256
SIGN_PRIVATE_KEY=
SIGN_CERT_PEM=

# ---- Browser web push (OPTIONAL - the Android app does not need it) ----
# Generate a NEW pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Optional ----
# CERT_KEY_TYPE=rsa
# CERT_DAYS=730

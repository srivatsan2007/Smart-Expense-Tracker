# Frontend (Vite) variables - template. Copy to frontend-react/.env
# Only VITE_* values are bundled into the app/APK, so NEVER put passwords or private keys here.
# Firebase web config is public by design; the defaults in src/firebase.js already match this project.

# Optional: force a backend URL (no trailing slash). The APK already defaults to the Render URL.
# VITE_API_URL=https://smart-expense-tracker-1-g5b4.onrender.com

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
